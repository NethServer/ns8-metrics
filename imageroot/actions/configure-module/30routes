# Write the Traefik routes from the saved settings. Also linked from
# restore-configuration and update-module.d.

import os

import agent
import agent.tasks

settings = agent.redis_connect().hgetall(f'module/{os.environ["MODULE_ID"]}/settings')
# Fall back to the environment for installs that predate the settings hash
grafana_path = settings.get('grafana_path', os.getenv('GRAFANA_PATH', '')).strip('/')
http_basic_auth_url = f"http://127.0.0.1:9311/api/module/{os.environ['MODULE_ID']}/http-basic/authorize-metrics"

# Prometheus is not exposed through Traefik: remove the route of older
# installs
response = agent.tasks.run(
    agent_id=agent.resolve_agent_id('traefik@node'),
    action='delete-route',
    data={
        'instance': os.environ['MODULE_ID'] + '_prometheus'
    },
)

# Configure Traefik to route grafana path requests to the grafana service
if grafana_path:
    agent.set_env("GRAFANA_PATH", grafana_path)
    response = agent.tasks.run(
        agent_id=agent.resolve_agent_id('traefik@node'),
        action='set-route',
        data={
            'instance': os.environ['MODULE_ID'] + '_grafana',
            'url': 'http://127.0.0.1:3000',
            'http2https': True,
            'path': f'/{grafana_path}',
            "forward_auth": {
                "address": http_basic_auth_url,
                "auth_response_headers": [ "X-Auth-User", "X-Auth-Token" ]
            }
        },
    )
else:
    # Remove traefik route
    agent.set_env("GRAFANA_PATH", "")
    response = agent.tasks.run(
        agent_id=agent.resolve_agent_id('traefik@node'),
        action='delete-route',
        data={
            'instance': os.environ['MODULE_ID'] + '_grafana'
        },
    )
