# Older certificate rules dropped the node label, so my received
# cert-*:<cn>:node:unknown alerts. The new rules never fire them again,
# and Alertmanager forgets them when 80services restarts it. Resolve
# them through alert-proxy while the old Alertmanager still runs.

import datetime
import json
import sys
import urllib.request

CERT_ALERTS = ('CertExpiringSoon', 'CertExpiringCritical', 'CertExpired')

try:
    with urllib.request.urlopen('http://127.0.0.1:9093/api/v2/alerts', timeout=10) as resp:
        active = json.load(resp)
except Exception as ex:
    print(f"Cannot read Alertmanager alerts, skipping: {ex}", file=sys.stderr)
    sys.exit(0)

# Match a real Alertmanager webhook: alert-proxy forwards it to Mimir as is.
now = datetime.datetime.now(datetime.timezone.utc).isoformat()
stale = [
    {
        'status': 'resolved',
        'labels': alert['labels'],
        'annotations': alert.get('annotations', {}),
        'startsAt': alert.get('startsAt', now),
        'endsAt': now,
    }
    for alert in active
    if alert.get('labels', {}).get('alertname') in CERT_ALERTS and 'node' not in alert['labels']
]
if not stale:
    sys.exit(0)

request = urllib.request.Request(
    'http://127.0.0.1:9095',
    data=json.dumps({'status': 'resolved', 'alerts': stale}).encode(),
    headers={'Content-Type': 'application/json'},
)
# alert-proxy answers once every alert is sent, and each send to my can
# retry for about 5 minutes. Stopping early lets 80services kill it.
try:
    urllib.request.urlopen(request, timeout=600).close()
    print(f"Resolved {len(stale)} certificate alerts without node label", file=sys.stderr)
except Exception as ex:
    print(f"Cannot resolve certificate alerts, skipping: {ex}", file=sys.stderr)
