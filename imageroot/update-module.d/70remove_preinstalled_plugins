# Grafana plugin preinstall is now disabled: remove the plugins that
# Grafana downloaded into its data volume, so the versions bundled in
# the Grafana image are used again and no stale copy is left behind.

# Skip if the administrator enabled preinstall again
[[ "$PODMAN_RUN_OPTS" == *GF_PLUGINS_PREINSTALL_DISABLED=false* ]] && exit 0

volume_path=$(podman volume inspect grafana-data --format '{{.Mountpoint}}' 2>/dev/null) || exit 0

# Default preinstall list of Grafana 12.0 - 13.2
plugins=(
    elasticsearch
    grafana-advisor-app
    grafana-exploretraces-app
    grafana-lokiexplore-app
    grafana-metricsdrilldown-app
    grafana-pathfinder-app
    grafana-postgresql-datasource
    grafana-pyroscope-app
    grafana-pyroscope-datasource
    influxdb
    jaeger
    loki
    mssql
    mysql
    opentsdb
    prometheus
    stackdriver
    tempo
    zipkin
)

for plugin in "${plugins[@]}"; do
    if [[ -d "${volume_path}/plugins/${plugin}" ]]; then
        echo "Removing preinstalled Grafana plugin ${plugin}" >&2
        # Plugin files are owned by the container user
        podman unshare rm -rf "${volume_path}/plugins/${plugin}"
    fi
done
